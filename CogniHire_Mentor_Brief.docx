PK3DocProps/app.xml<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<Properties xmlns="http://schemas.openxmlformats.org/officeDocument/2006/extended-properties" xmlns:vt="http://schemas.openxmlformats.org/officeDocument/2006/docPropsVTypes"><TotalTime>1</TotalTime></Properties>PK3DocProps/core.xml<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<cp:coreProperties xmlns:cp="http://schemas.openxmlformats.org/package/2006/metadata/core-properties" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:dcmitype="http://purl.org/dc/dcmitype/"><dc:title>CogniHire AI - Mentor Brief</dc:title><dc:subject>Interview Intelligence System</dc:subject><dc:creator>Devesh S V</dc:creator></cp:coreProperties>PK3_rels/.rels<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="word/document.xml"/><Relationship Id="rId2" Type="http://schemas.openxmlformats.org/package/2006/relationships/metadata/core-properties" Target="DocProps/core.xml"/><Relationship Id="rId3" Type="http://schemas.openxmlformats.org/package/2006/relationships/metadata/extended-properties" Target="DocProps/app.xml"/></Relationships>PK3word/document.xml<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<w:document xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><w:body><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>CogniHire AI — Mentor Brief</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>One-Page Executive + Technical Deep-Dive</w:t></w:r></w:p><w:p><w:r><w:br/></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>⚡ ONE-PAGE EXECUTIVE SUMMARY</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading3"/></w:pPr><w:r><w:t>The Opportunity</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>Problem:</w:t></w:r><w:r><w:t> AI hiring tools verify identity once at login, then assume all work is the candidate's own. No system adapts the interview based on how the candidate works—and no one verifies who is still at the keyboard.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>Solution:</w:t></w:r><w:r><w:t> CogniHire is a pre-screening gate that does two things existing platforms don't:</w:t></w:r></w:p><w:p><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t>Continuous identity verification</w:t></w:r><w:r><w:t> (facial embedding matching, 15–25s windows)</w:t></w:r></w:p><w:p><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t>Adaptive questioning</w:t></w:r><w:r><w:t> (follow-ups triggered by keystroke patterns; candidate explains live)</w:t></w:r></w:p><w:p><w:r><w:t>Result: recruiter gets a transparent audit (who did what, how they approached it) instead of a score.</w:t></w:r></w:p><w:p><w:r><w:br/></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading3"/></w:pPr><w:r><w:t>Why Now</w:t></w:r></w:p><w:p><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t>Market gap:</w:t></w:r><w:r><w:t> 17 competitors studied; none do live adaptive follow-ups on provenance signals</w:t></w:r></w:p><w:p><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numId></w:numPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t>Regulatory tailwind:</w:t></w:r><w:r><w:t> NYC LL144, Illinois AIVI (2026-01-01), EU AI Act all require audit trails for hiring decisions</w:t></w:r></w:p><w:p><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numId></w:numPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t>Customer need:</w:t></w:r><w:r><w:t> 5 recruiter interviews confirm "We need to know who did the work and why"</w:t></w:r></w:p><w:p><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numId></w:numPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t>HireVue precedent:</w:t></w:r><w:r><w:t> facial scoring contributed 0.25% value; they dropped it. We don't build weak signals.</w:t></w:r></w:p><w:p><w:r><w:br/></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading3"/></w:pPr><w:r><w:t>What's Next</w:t></w:r></w:p><w:p><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr></w:pPr><w:r><w:t>Threshold calibration (FAR/FRR on real data)</w:t></w:r></w:p><w:p><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numId></w:numPr></w:pPr><w:r><w:t>Persistence layer (multi-run demos)</w:t></w:r></w:p><w:p><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numId></w:numPr></w:pPr><w:r><w:t>Claim extraction (resume → claims)</w:t></w:r></w:p><w:p><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numId></w:numPr></w:pPr><w:r><w:t>Customer validation (pilot with recruiting teams)</w:t></w:r></w:p><w:p><w:r><w:br/></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>🔬 TECHNICAL DEEP-DIVE</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading3"/></w:pPr><w:r><w:t>Core Innovation: Provenance + Process</w:t></w:r></w:p><w:p><w:r><w:t>Traditional hire-by-code platforms verify identity at login but never re-verify mid-task. CogniHire solves this with continuous biometric verification combined with process telemetry that flags anomalies and adapts questioning.</w:t></w:r></w:p><w:p><w:r><w:t>HackerRank and CodeSignal record keystroke playback for retrospective fraud flagging, but never feed it into live interview to ask follow-up questions. CogniHire solves this: three trigger patterns (bulkInsert, pauseThenBulk, immediateAnswer) generate rule-selected follow-ups. Candidate must comprehend live, in their own words — materially harder than producing or pasting.</w:t></w:r></w:p><w:p><w:r><w:br/></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading3"/></w:pPr><w:r><w:t>Working Prototype</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>Flutter App (69 Tests Green):</w:t></w:r></w:p><w:p><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="4"/></w:numPr></w:pPr><w:r><w:t>Core: Pure Dart verification stack (testable, no platform dependencies)</w:t></w:r></w:p><w:p><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="4"/></w:numId></w:numPr></w:pPr><w:r><w:t>Features: Enrolment → interview → live follow-ups → audit</w:t></w:r></w:p><w:p><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="4"/></w:numId></w:numPr></w:pPr><w:r><w:t>Platforms: Windows, Android, Web</w:t></w:r></w:p><w:p><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="4"/></w:numId></w:numPr></w:pPr><w:r><w:t>Camera: Real hardware (no virtual camera fallback)</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>Python Face Service:</w:t></w:r></w:p><w:p><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="5"/></w:numPr></w:pPr><w:r><w:t>Models: SCRFD (detection) + ArcFace (512-d embeddings, WebFace600K)</w:t></w:r></w:p><w:p><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="5"/></w:numId></w:numPr></w:pPr><w:r><w:t>Approach: Strict error reporting. embedding_available: bool never null-as-default.</w:t></w:r></w:p><w:p><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="5"/></w:numId></w:numPr></w:pPr><w:r><w:t>Training: Zero. Everything beyond embeddings is arithmetic (cosine) + authored rules.</w:t></w:r></w:p><w:p><w:r><w:br/></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading3"/></w:pPr><w:r><w:t>Market Validation</w:t></w:r></w:p><w:p><w:r><w:t>Competitor landscape (17 vendors studied): HireVue does composite scoring + video analysis; HackerRank ships keystroke playback for retrospective review; CodeSignal has playback + Suspicion Score. Gap identified: None feed process signal into a live interview that adapts.</w:t></w:r></w:p><w:p><w:r><w:t>Customer validation (5 technical recruiters): Fraud rate 4–8% estimated. Pain point: "We need to know who did the work and why they chose their approach, not a score." Regulatory pressure: "We're prepping for NYC LL144; we need audit trails."</w:t></w:r></w:p><w:p><w:r><w:br/></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading3"/></w:pPr><w:r><w:t>Regulatory Tailwind</w:t></w:r></w:p><w:p><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="6"/></w:numPr></w:pPr><w:r><w:t>NYC Local Law 144 (2023) — "bias audit" required for automated employment decisions</w:t></w:r></w:p><w:p><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="6"/></w:numId></w:numPr></w:pPr><w:r><w:t>Illinois AI Video Interview Transparency Act + IHRA amendment (eff. 2026-01-01)</w:t></w:r></w:p><w:p><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="6"/></w:numId></w:numPr></w:pPr><w:r><w:t>EU AI Act (2024) — hiring = high-risk; "human oversight" required; explainability mandatory</w:t></w:r></w:p><w:p><w:r><w:br/></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading3"/></w:pPr><w:r><w:t>What We Deliberately Don't Build</w:t></w:r></w:p><w:p><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="7"/></w:numPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t>Facial emotion / personality inference</w:t></w:r><w:r><w:t> — Pseudoscience + discrimination risk</w:t></w:r></w:p><w:p><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="7"/></w:numId></w:numPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t>Single composite score</w:t></w:r><w:r><w:t> — Regulatory ceiling (NYC LL144, AIVI, EU AI Act)</w:t></w:r></w:p><w:p><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="7"/></w:numId></w:numPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t>Typing speed as ability</w:t></w:r><w:r><w:t> — Uncorrelated with code quality. Penalizes motor differences.</w:t></w:r></w:p><w:p><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="7"/></w:numId></w:numPr></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t>Demographic inference</w:t></w:r><w:r><w:t> — We don't load the gender/age classifier at all (saves ~143MB; prevents data leakage).</w:t></w:r></w:p><w:p><w:r><w:br/></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading3"/></w:pPr><w:r><w:t>Why This Matters</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>For hiring:</w:t></w:r><w:r><w:t> Closes a market gap (continuous provenance + adaptive process not commoditized). Defensible legally (audit trail, no black-box scoring, transparent rules). Built for trust (recruiter-friendly, candidate-friendly).</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>For you:</w:t></w:r><w:r><w:t> Ship a working system in 48 hours. Validate market assumptions. A customer pilot is the next step, not more features.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>For regulators / courts:</w:t></w:r><w:r><w:t> When (not if) hiring AI is audited, CogniHire has the receipts—who did what, why, when, and a structured log. No fabricated confidence scores. No demographic inference. No accusation; just evidence.</w:t></w:r></w:p><w:p><w:r><w:br/></w:r></w:p><w:p><w:pPr><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t>Solo build, 2026-07-26 to 2026-07-27. 69 tests green. Research audit complete. Ready to validate with customers.</w:t></w:r></w:p></w:body></w:document>PK3word/_rels/document.xml.rels<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"></Relationships>PK3[Content_Types].xml<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Default Extension="xml" ContentType="application/xml"/><Override PartName="/word/document.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml"/></Types>PK