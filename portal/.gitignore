node_modules/
.next/
tsconfig.tsbuildinfo
.env.local

# The root .gitignore excludes `.env.*` so a secret can never be committed
# by accident. This one file is the deliberate exception: it holds only the
# public gateway URL, and it MUST ship, because a deployed build without it
# silently falls back to http://localhost:8000 — a portal that renders
# perfectly and can never reach the backend. Real secrets still go in
# .env.local, which stays ignored above.
!.env.production

.vercel
