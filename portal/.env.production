# The deployed gateway. `NEXT_PUBLIC_` is required for Next.js to inline
# this into the browser bundle — which is safe here: this is a public URL,
# not a secret. No key, prompt, or provider name ever reaches this app (see
# lib/gateway.js).
#
# Committed on purpose, unlike .env.local: this is the production default,
# and a missing value would silently fall back to http://localhost:8000 in
# a deployed build — a portal that looks fine and can never reach anything.
NEXT_PUBLIC_GATEWAY_URL=https://api.cognihire.online
