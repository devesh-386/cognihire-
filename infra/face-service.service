[Unit]
Description=CogniHire face service
After=network.target

[Service]
Type=simple
User=cognihire
WorkingDirectory=/opt/cognihire/service
Environment="ALLOWED_ORIGINS=https://hr.example.com,https://interview.example.com"
ExecStart=/opt/cognihire/service/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=on-failure

[Install]
WantedBy=multi-user.target
